# Tibero 접속 정보 (source .env 후 사용하거나 셸에 export)
# DSN 방식 (권장) - unixODBC 의 odbc.ini 에 등록해 둔 이름
TB_DSN=TIBERO

# DSN 없이 드라이버를 직접 지정하는 방식
#TB_DRIVER=/home/tibero/tibero6/client/lib/libtbodbc.so
#TB_HOST=127.0.0.1
#TB_PORT=8629
#TB_DB=tibero

TB_USER=scott
TB_PASSWORD=tiger

# 클라이언트 캐릭터셋. DB 의 NLS_CHARACTERSET 과 같게 맞추는 것이 가장 안전하다.
TB_NLS_LANG=KOREAN_KOREA.UTF8

# 테스트 (npm run test:integration)
# 위 접속 정보로 통합 테스트가 돈다. 전용 계정은 test/integration/setup-test-user.sql 참고.
# 1 이면 접속 정보/odbc 가 없을 때 skip 대신 실패 (CI 용)
#TB_TEST_REQUIRED=1
